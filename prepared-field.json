{"version":2,"wgsl":"// vgsl-module: C:\\Users\\Victor\\Desktop\\hermes_work\\vgpu-lab\\proto\\shader3.wgsl\n// shader3.wgsl — поле для секции фактов: очень тихая сетка точек, редкая тёплая волна\nstruct _vgsl_eb68da83__Params {\n  time: f32,\n  texel: vec2f,\n  accent: vec3f,\n  ink: vec3f,\n  // x: позиция скролла 0..1 внутри секции, y: 1 когда секция видима\n  scroll: vec2f,\n}\n\n@group(0) @binding(0) var<uniform> params: _vgsl_eb68da83__Params;\n\n\n\nfn _vgsl_eb68da83__spot(p: vec2f, c: vec2f, r: f32) -> f32 {\n  let d = length(p - c);\n  return smoothstep(r, r * 0.25, d);\n}\n\n@fragment\nfn fs_main(@location(0) uv: vec2f) -> @location(0) vec4f {\n  let t = params.time;\n  let vis = params.scroll.y;\n  let aspect = params.texel.y / params.texel.x;\n  var p = vec2f(uv.x * 2.0 - 1.0, (uv.y * 2.0 - 1.0) * aspect);\n\n  var col = vec3f(0.0);\n\n  // тихое поле: сетка 14x7, каждая точка едва заметно дышит\n  var field = 0.0;\n  for (var i: i32 = 0; i < 14; i = i + 1) {\n    for (var j: i32 = 0; j < 7; j = j + 1) {\n      let x = -0.95 + f32(i) * 0.146;\n      let y = -0.75 + f32(j) * 0.25;\n      let ph = t * 0.5 + f32(i) * 0.4 + f32(j) * 0.9;\n      let breathe = 0.5 + 0.5 * sin(ph);\n      let r = 0.004 + 0.003 * breathe;\n      field += _vgsl_eb68da83__spot(p, vec2f(x, y), r) * (0.25 + 0.35 * breathe);\n    }\n  }\n  col += params.accent * field * 0.30;\n\n  // редкая тёплая волна: раз в ~6 сек проход слева направо, высвечивает точки\n  let waveT = fract(t / 6.0);\n  let waveX = -1.2 + waveT * 2.4;\n  var wave = 0.0;\n  for (var i: i32 = 0; i < 14; i = i + 1) {\n    for (var j: i32 = 0; j < 7; j = j + 1) {\n      let x = -0.95 + f32(i) * 0.146;\n      let y = -0.75 + f32(j) * 0.25;\n      let boost = smoothstep(0.35, 0.0, abs(x - waveX));\n      wave += _vgsl_eb68da83__spot(p, vec2f(x, y), 0.006 + 0.008 * boost) * boost * 0.9;\n    }\n  }\n  col += params.accent * wave * 0.9;\n\n  // скролл-реакция: при движении по секции поле чуть ярче\n  col *= 0.8 + 0.4 * vis;\n\n  let vignette = smoothstep(1.7, 0.7, length(p));\n  col *= vignette;\n  return vec4f(col * vis, 0.0);\n}\n","reflection":{"bindings":[{"group":0,"binding":0,"name":"params","mangledName":"params","type":{"kind":"identifier","name":"_vgsl_eb68da83__Params","mangledName":"_vgsl_eb68da83___vgsl_eb68da83__Params"},"kind":"buffer","addressSpace":"uniform","struct":{"name":"_vgsl_eb68da83__Params","mangledName":"_vgsl_eb68da83___vgsl_eb68da83__Params","members":[{"name":"time","type":{"kind":"scalar","name":"f32"}},{"name":"texel","type":{"kind":"vector","width":2,"element":{"kind":"scalar","name":"f32"}}},{"name":"accent","type":{"kind":"vector","width":3,"element":{"kind":"scalar","name":"f32"}}},{"name":"ink","type":{"kind":"vector","width":3,"element":{"kind":"scalar","name":"f32"}}},{"name":"scroll","type":{"kind":"vector","width":2,"element":{"kind":"scalar","name":"f32"}}}]},"layout":{"name":"params","mangledName":"params","layoutMode":"wgsl-host-shareable-v1","type":{"kind":"identifier","name":"_vgsl_eb68da83__Params","mangledName":"_vgsl_eb68da83___vgsl_eb68da83__Params"},"align":16,"size":64,"members":[{"name":"time","offset":0,"align":4,"size":4,"type":{"kind":"scalar","name":"f32"},"layout":{"name":"time","mangledName":"time","layoutMode":"wgsl-host-shareable-v1","type":{"kind":"scalar","name":"f32"},"align":4,"size":4}},{"name":"texel","offset":8,"align":8,"size":8,"type":{"kind":"vector","width":2,"element":{"kind":"scalar","name":"f32"}},"layout":{"name":"texel","mangledName":"texel","layoutMode":"wgsl-host-shareable-v1","type":{"kind":"vector","width":2,"element":{"kind":"scalar","name":"f32"}},"align":8,"size":8}},{"name":"accent","offset":16,"align":16,"size":12,"type":{"kind":"vector","width":3,"element":{"kind":"scalar","name":"f32"}},"layout":{"name":"accent","mangledName":"accent","layoutMode":"wgsl-host-shareable-v1","type":{"kind":"vector","width":3,"element":{"kind":"scalar","name":"f32"}},"align":16,"size":12}},{"name":"ink","offset":32,"a